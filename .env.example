# ═══════════════════════════════════════════════════════════════
# Unite Attendance — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Database (Supabase PostgreSQL) ─────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── Redis (AWS ElastiCache / local) ────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT Auth ────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-min-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# ─── Supabase (Storage only — NOT auth) ─────────────────────
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Email (Free SMTP: Brevo / Gmail / Custom) ────────────────
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username-or-email"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Unite Attendance <noreply@unite-attendance.com>"

# ─── Razorpay (Billing) ─────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ─── Web Push (VAPID Keys) ──────────────────────────────────
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@unite-attendance.com"

# ─── API Configuration ──────────────────────────────────────
API_PORT=3001
API_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004"

# ─── Frontend URLs ──────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001/ws"
NEXT_PUBLIC_APP_NAME="Unite Attendance"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"
NEXT_PUBLIC_KIOSK_URL="http://localhost:3003"
NEXT_PUBLIC_APP_URL="http://localhost:3004"

# ─── Super Admin (Seed) ─────────────────────────────────────
SUPER_ADMIN_EMAIL="admin@unite-attendance.com"
SUPER_ADMIN_PASSWORD="changeme123!"
SUPER_ADMIN_NAME="Super Admin"
